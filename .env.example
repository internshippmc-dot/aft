# Copy to .env and fill in. Never commit the real .env file.

POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://aft:changeme@db:5432/aft_console

# development | production — controls cookie Secure flag and error verbosity
APP_ENV=development

# comma-separated origins allowed to send credentialed requests in dev
# (production serves frontend same-origin and does not need this)
DEV_CORS_ORIGIN=http://localhost:5173

# --- production only (docker-compose.prod.yml) ---

# domain Caddy requests a TLS cert for — DNS A record must point here first
DOMAIN=

# public half of an age keypair for scripts/backup.sh — generate with:
#   age-keygen -o backup.key
# then paste the "public key: age1..." line's value here. Keep backup.key
# itself off this server.
BACKUP_AGE_PUBLIC_KEY=

# --- Shopify order sync (PRD.md F8) ---

# e.g. 086b53.myshopify.com
SHOPIFY_SHOP=
# minted once via a local OAuth run (see Shopify-Excel-Exporter), not by this app
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-01

# --- iThink Logistics (booking + tracking) ---

ITHINK_ACCESS_TOKEN=
ITHINK_SECRET_KEY=
# Pickup/return address ids are NOT set here — this account books from more
# than one warehouse, so the address is chosen per booking in the UI. See
# PICKUP_ADDRESSES in backend/app/integrations/ithink.py.
